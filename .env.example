# Browser key: restrict by HTTP referrer (localhost:3000/*, your *.vercel.app, your domain)
# and by API (Maps JavaScript API). Create it in Google Cloud Console.
NEXT_PUBLIC_GMAPS_KEY=

# Optional: a Cloud-based map style ID (vector). Falls back to DEMO_MAP_ID in development.
NEXT_PUBLIC_MAP_ID=

# Optional: live "N people here now" counter, via Firebase Realtime Database (free tier).
# All five values come from Firebase Console > Project settings > General > Your apps (Web app) config.
# Leave blank to keep the counter off. See README for the one-time Firebase setup steps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
